{
  "name": "gamebrain-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "doctor": "node scripts/setup.mjs --check",
    "test:connectivity": "node --experimental-strip-types --test tests/connectivity-*.test.mjs",
    "test:ui": "node --test tests/image-workflow.test.mjs tests/localization.test.mjs",
    "update:experiments": "node --experimental-strip-types scripts/update-experiments.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.3",
    "@react-three/fiber": "^9.3.0",
    "lucide-react": "^1.72.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "^0.179.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/three": "^0.179.0",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  }
}
